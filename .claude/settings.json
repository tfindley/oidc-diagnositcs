{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(python3 -m py_compile *)",
      "Bash(grep -n *)",
      "Bash(grep -rn *)",
      "Bash(grep -rl *)",
      "Bash(find . -name *)",
      "Bash(find . -type *)",
      "Bash(wc -l *)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff HEAD)",
      "Bash(git diff --stat)",
      "Bash(git diff --staged)",
      "Bash(git log --oneline -*)",
      "Bash(git log -*)",
      "Bash(git branch --show-current)",
      "Bash(git ls-files *)",
      "Bash(gh run list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh api *)"
    ]
  }
}
